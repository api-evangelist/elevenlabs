          "name": "Create instant voice clone",
          "request": {
            "name": "Create instant voice clone",
            "description": {
              "content": "Creates a new voice clone from uploaded audio samples using instant voice cloning. Requires a minimum of 60 seconds of clean audio. The cloned voice is immediately available for use with speech generation endpoints.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "voices",
                "add"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "name",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) The name for the cloned voice."
                },
                {
                  "key": "files",
                  "value": "[\"<binary>\",\"<binary>\"]",
                  "type": "text",
                  "description": "(Required) Audio sample files for cloning. A minimum of 60 seconds of clean audio is recommended for best results."
                },
                {
                  "key": "description",
                  "value": "<string>",
                  "type": "text",
                  "description": "Description of the cloned voice and its intended use."
                },
                {
                  "key": "labels",
                  "value": "<string>",
                  "type": "text",
                  "description": "JSON string of key-value label pairs describing the voice characteristics such as accent, age, and gender."
